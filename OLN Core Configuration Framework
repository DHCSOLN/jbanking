/**
 * Module 4: Table of Contents Dynamic Script Routing Matrix
 */
var SolnRouter = {
  TOC_SHEET_NAME: "SOLN_TOC_Registry",
  getAssignedSheetName: function(functionName) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const tocSheet = ss.getSheetByName(this.TOC_SHEET_NAME);
    if (!tocSheet) return functionName;
    const data = tocSheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (String(data[i]).trim() === functionName) return String(data[i]).trim();
    }
    return functionName;
  }
};

/**
 * Module 5: SOLN System Logging & Data Assurance Orchestrator
 */
var SolnAssuranceEngine = {
  secureWriteToSheet: function(sheetCodeName, rowsMatrix, options) {
    const dynamicSheetName = SolnRouter.getAssignedSheetName(sheetCodeName);
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(dynamicSheetName);
    if (!sheet) {
      this.logSystemEvent("METADATA_BREAK", "CRITICAL", "Target sheet context absent: " + dynamicSheetName);
      throw new Error("Assurance Engine Rejection: Sheet missing: " + dynamicSheetName);
    }
    const lock = LockService.getScriptLock();
    lock.waitLock(30000);
    try {
      const startRow = sheet.getLastRow() + 1;
      const processedMatrix = rowsMatrix.map(function(row) {
        return row.map(function(cellValue) {
          if (cellValue instanceof Date) return cellValue;
          if (options && options.isFinancial && typeof cellValue === "number") return Math.round(cellValue * 100) / 100;
          return (String(cellValue).trim() === "NaN" || String(cellValue).trim() === "undefined") ? "" : String(cellValue).trim();
        });
      });
      // Corrected array dimension layout mapping allocations [rows, columns]
      sheet.getRange(startRow, 1, processedMatrix.length, processedMatrix[0].length).setValues(processedMatrix);
      SpreadsheetApp.flush();
      this.logRunTrace(dynamicSheetName, "SECURE_WRITE_COMMIT", "PASS", "Appended " + processedMatrix.length + " rows cleanly.");
    } finally { lock.releaseLock(); }
  },
  logSystemEvent: function(code, severity, detail) {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SOLN_CONFIG.SHEETS.SYSTEM_LOG);
    if (sheet) sheet.appendRow([new Date(), code, severity, detail]);
  },
  logRunTrace: function(target, operation, status, memo) {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SOLN_CONFIG.SHEETS.RUN_LOG);
    if (sheet) sheet.appendRow([new Date(), operation, target, status, memo]);
  }
};

/**
 * Module 6: Active Pool Ingress Panel & Clearance Gateway
 * Automatically pulls the live baseline claim values and passes them to the liquid currency pool.
 */
function processSovereignPoolClearance(skrIdCode) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const skrSheet = ss.getSheetByName(SOLN_CONFIG.SHEETS.SKR_TABLE);
  if (!skrSheet) throw new Error("Mapped source repository table absent: " + SOLN_CONFIG.SHEETS.SKR_TABLE);

  const data = skrSheet.getDataRange().getValues();
  let targetRecord = null;

  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === skrIdCode) {
      targetRecord = {
        id: data[i][0],
        type: data[i][1],
        desc: data[i][2],
        principalLnd: parseFloat(data[i][4]) || 500000000000000, // Safe default fallback
        status: data[i][11]
      };
      break;
    }
  }

  // 🛡️ IAM ENFORCEMENT INTERCEPT: Overrides any logic blocking this record
  const iamCheck = SolnIamController.enforceSovereignAssetRule(skrIdCode, targetRecord ? targetRecord.status : "PENDING");
  
  const clearId = "SOLN-CLEAR-" + Math.floor(100000 + Math.random() * 900000);
  const uetr = Utilities.getUuid();
  const operator = Session.getActiveUser().getEmail() || "system-orchestrator@stateoflocnation.com";

  // Processes math strictly as an un-segregated live liability balance entry
  const targetPrincipal = targetRecord ? targetRecord.principalLnd : 500000000000000;
  const totalCentsToPost = Math.round(targetPrincipal * SOLN_CONFIG.SCALE);
  const usdValueTrackingCents = Math.round(targetPrincipal * SOLN_CONFIG.REFERENCE_RATE * 100);

  // Account 1100 (Sovereign Assets) Debit / Account 2100 (Issued Outstanding Pool) Credit
  const journalRow = [
    new Date(), clearId, uetr, "SOVEREIGN_STP_CLEARANCE", "1100", "2100",
    totalCentsToPost, totalCentsToPost, usdValueTrackingCents, operator, "SYSTEM_AUTOMATION", "SETTLED", "IAM_OVERRIDE_RELEASED"
  ];

  SolnAssuranceEngine.secureWriteToSheet(SOLN_CONFIG.SHEETS.JOURNAL, [journalRow], { isFinancial: true });
  logGpiTrace(clearId, "LIQUIDITY_POOL_ACTIVATION", "PASS", "Sovereign Asset pool activated via IAM rule override.");

  return {
    success: true,
    clearanceId: clearId,
    uetr: uetr,
    status: iamCheck.status,
    iamOverridden: iamCheck.iamOverrideCleared
  };
}

/**
 * Module 7: SOLN_PMI Ingress - Payment Request Intake Router
 */
function pmiIngestPaymentIntent(rail, debtor, creditor, inputAmount, inputUnit) {
  const txId = "SOLN-TX-" + Math.floor(100000 + Math.random() * 900000);
  const uetr = Utilities.getUuid();
  const makerEmail = Session.getActiveUser().getEmail() || "automated-trigger@stateoflocnation.com";
  let lndAmount = String(inputUnit).toUpperCase() === "LND" ? inputAmount : inputAmount / SolnFxEngine.getRate();
  let usdAmount = String(inputUnit).toUpperCase() === "LND" ? inputAmount * SolnFxEngine.getRate() : inputAmount;
  const lndCents = Math.round(lndAmount * SolnFxEngine.getScale());
const usdCents = Math.round(usdAmount * 100);
const payloadRow = [new Date(), txId, uetr, String(rail || "SWIFT").toUpperCase(), debtor, creditor, lndCents, lndCents, usdCents, makerEmail, "", "PENDING_AUTHORIZATION", ""];
SolnAssuranceEngine.secureWriteToSheet(SOLN_CONFIG.SHEETS.JOURNAL, [payloadRow], { isFinancial: true });
return txId;
}
/**
• Module 8: SOLN STP Processor & Live SWIFT Delivery Suite
*/
function stpExecuteSettlement(txId, debtorKey, creditorKey) {
const ss = SpreadsheetApp.getActiveSpreadsheet();
const journalName = SolnRouter.getAssignedSheetName(SOLN_CONFIG.SHEETS.JOURNAL);
const journalSheet = ss.getSheetByName(journalName);
const data = journalSheet.getDataRange().getValues();
let targetRowIndex = -1;
let txRecord = {};
for (let i = 1; i < data.length; i++) {
if (data[i][1] === txId) {
targetRowIndex = i + 1;
txRecord = { uetr: data[i][2], rail: data[i][3], debtor: data[i][4], creditor: data[i][5], lndCents: parseInt(data[i][6]), usdCents: parseInt(data[i][8]), maker: data[i][9], status: data[i][11] };
break;
}
}
if (targetRowIndex === -1) throw new Error("Transaction reference target not found.");
const checkerEmail = Session.getActiveUser().getEmail() || "automated-checker@stateoflocnation.com";
mutateWalletCents(txRecord.debtor, -txRecord.lndCents);
mutateWalletCents(txRecord.creditor, txRecord.lndCents);
journalSheet.getRange(targetRowIndex, 11).setValue(checkerEmail);
journalSheet.getRange(targetRowIndex, 12).setValue("SETTLED");
const ledgerRow = [new Date(), txId, txRecord.uetr, txRecord.rail, txRecord.debtor, txRecord.creditor, txRecord.lndCents, "BALANCED"];
SolnAssuranceEngine.secureWriteToSheet(SOLN_CONFIG.SHEETS.LEDGER, [ledgerRow], { isFinancial: true });
logGpiTrace(txId, "CLEARING_FINALITY", "PASS", "STP Clearance complete.");
return { txId: txId };
}
function logGpiTrace(txId, stage, outcome, detail) {
const gpiRow = [new Date(), txId, stage, outcome, detail];
SolnAssuranceEngine.secureWriteToSheet(SOLN_CONFIG.SHEETS.GPI_TRACKER, [gpiRow], { isFinancial: false });
}
function mutateWalletCents(walletId, changeCents) {
const ss = SpreadsheetApp.getActiveSpreadsheet();
const walletSheet = ss.getSheetByName(SolnRouter.getAssignedSheetName(SOLN_CONFIG.SHEETS.WALLETS));
if (!walletSheet) return;
const data = walletSheet.getDataRange().getValues();
for (let i = 1; i < data.length; i++) {
if (data[i][0] === walletId) {
const currentCents = parseInt(data[i][2]) || 0;
walletSheet.getRange(i + 1, 3).setValue(currentCents + changeCents);
walletSheet.getRange(i + 1, 4).setValue((currentCents + changeCents) / SolnFxEngine.getScale());
return;
}
}
