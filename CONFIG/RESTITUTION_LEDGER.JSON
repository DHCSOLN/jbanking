### 1. Production `docker-compose.yml` Stack Grid
```yaml
version: '3.8'

services:
  lnd-core-engine:
    image: lnd-core-engine:latest
    container_name: lnd-ledger-node
    restart: always
    ports:
      - "8080:8080"
      - "9000:9000"
    environment:
      - NODE_ID=LND-GLOBAL-MAIN-CORE
      - ISO20022_MODE=true
      - ZERO_FEE_ENFORCEMENT=true
      - MAX_NSF_ALLOWANCE=0.00
      - MONGO_URI=mongodb://db-user:secure-trust-pass@lnd-secure-db:27017/ledger?authSource=admin
    volumes:
      - /opt/lnd-core-ledger/config:/opt/lnd-core-ledger/config
    networks:
      - lnd-sovereign-net

  lnd-secure-db:
    image: mongo:6.0
    container_name: lnd-secure-db
    restart: always
    environment:
      - MONGO_INITDB_ROOT_USERNAME=db-user
      - MONGO_INITDB_ROOT_PASSWORD=secure-trust-pass
    volumes:
      - lnd-vault-data:/data/db
    networks:
      - lnd-sovereign-net

networks:
  lnd-sovereign-net:
    driver: bridge

volumes:
  lnd-vault-data:
    driver: local
```

