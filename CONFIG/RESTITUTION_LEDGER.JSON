const WebSocket = require('ws');

function initializeWalletSync(walletAddress, nodeHostIp) {
    const wsUrl = `ws://${nodeHostIp}:9000/api/v1/wallets/stream?address=${walletAddress}`;
    const ws = new WebSocket(wsUrl);

    console.log(`=== STARTING WALLET CONNECTION TO IMMUTABLE REVENUE ENGINE [${walletAddress}] ===`);

    ws.on('open', function open() {
        console.log('TECHNICAL HANDSHAKE SECURE: Connected directly to sovereign network core.');
        
        // Emit initial authentication packet to register user session data
        const authPacket = {
            action: "WALLET_AUTHENTICATE",
            address: walletAddress,
            timestamp: new Date().toISOString()
        };
        ws.send(JSON.stringify(authPacket));
    });

    ws.on('message', function message(data) {
