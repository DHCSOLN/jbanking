async function uploadAndProcessBatchCSV(fileInputEvent) {
  const file = fileInputEvent.target.files[0];
  const reader = new FileReader();

  reader.onload = async function(e) {
    const text = e.target.result;
    const lines = text.split('\n');
    const batchPayload = [];

    // Parse CSV rows skipping the header (Format: Direction,Amount,VendorName,Routing)
    for (let i = 1; i < lines.length; i++) {
      if (!lines[i].trim()) continue;
      const columns = lines[i].split(',');
      
      batchPayload.push({
        direction: columns[0].trim(),     // "USD_TO_LND"
        amount: columns[1].trim(),        // "346.00"
        vendorName: columns[2].trim(),    // "GEORGIA POWER"
        routingNumber: columns[3].trim(), // "61000609"
        targetWallet: "LND-9CB971D86EE6414B",
        makerStatus: "PASS",
        checkerStatus: "PASS"
      });
    }

    // Fire the entire batch block over to the bridge in one execution
    try {
      const response = await fetch('/api/settle/execute-settlement-batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(batchPayload)
      });
      
      const batchResult = await response.json();
      console.log("Batch Processed Summary:", batchResult);
      alert(`Batch settlement run closed. Successfully cleared items check logs.`);
    } catch (err) {
      console.error("Batch processing error: ", err);
    }
  };

  reader.readAsText(file);
}
